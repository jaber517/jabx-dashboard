generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  summary     String
  description String
  category    String
  status      String
  priority    String
  progress    Int            @default(0)
  owner       String?
  imageUrl    String?
  dueDate     DateTime?
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tasks       Task[]
  notes       Note[]
  milestones  Milestone[]
  resources   ResourceLink[]
  activities  Activity[]
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String
  status      String    @default("TODO")
  priority    String
  dueDate     DateTime?
  blocked     Boolean   @default(false)
  category    String
  imageUrl    String?
  createdById String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Note {
  id          String    @id @default(cuid())
  title       String
  content     String
  tags        String
  category    String
  imageUrl    String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model ResourceLink {
  id          String    @id @default(cuid())
  title       String
  description String
  url         String
  type        String
  category    String
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  summary     String
  status      String
  date        DateTime
  category    String
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
}

model Activity {
  id          String    @id @default(cuid())
  action      String
  description String
  entityType  String
  category    String
  createdById String?
  createdAt   DateTime  @default(now())
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
}
// Sign-in. These three tables are also created on demand by lib/auth-store.ts
// (CREATE TABLE IF NOT EXISTS), so a deployed database needs no manual
// migration. Keep the two in step.

// One row per signed-in device. `id` is the SHA-256 of the random session
// token in the cookie, so a leaked table can't be replayed as cookies.
model AuthSession {
  id         String   @id
  method     String
  userAgent  String   @default("")
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
}

// A registered passkey (WebAuthn credential). Only the public key is stored.
model Passkey {
  id         String    @id
  publicKey  String
  counter    Int       @default(0)
  transports String    @default("")
  name       String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

// Failed passcode attempts, for rate limiting and lockout.
model LoginFailure {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}
