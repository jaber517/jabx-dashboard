DATABASE_URL="file:./dev.db"

# Password that unlocks /dashboard (set your own in Vercel)
DASHBOARD_PASSWORD="choose-a-strong-password"

# Optional: Turso cloud database (leave unset to use the local SQLite file)
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Server-only URL for the laptop AI Team bridge (for example, https://team.jabx.me)
TEAM_BRIDGE_URL=""
# Cloudflare Access service-token credentials used only by the dash server
CF_ACCESS_CLIENT_ID=""
CF_ACCESS_CLIENT_SECRET=""
# Shared 32-byte base64url bridge-signing key; never expose it to the browser
TEAM_BRIDGE_SECRET=""
